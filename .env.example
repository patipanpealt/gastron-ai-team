# Anthropic API key — get one at https://platform.claude.com/settings/keys
# Leave empty to run the office in DEMO mode (scripted output, no API cost).
ANTHROPIC_API_KEY=

# OR use Google Gemini instead (has a free tier) — key from https://aistudio.google.com/apikey
# The free tier may let Google use your prompts to improve its products: don't put confidential data in briefs.
GEMINI_API_KEY=
# gemini-3.8-flash is the default; gemini-3.5-flash-lite is cheaper/faster
GEMINI_MODEL=
# OR route through a local OmniRoute (npm i -g omniroute; dashboard http://localhost:20128 -> API Keys). Used first when set.
OMNIROUTE_KEY=
# provider/model, or the name of a combo made in OmniRoute (default gemini/gemini-3.8-flash)
OMNIROUTE_MODEL=
OMNIROUTE_URL=
# Force a provider: omniroute | gemini | claude (default: first key found in that order)
AI_PROVIDER=

# Login (email + password). Leave AUTH_USERS empty to disable login (local use only).
# JSON list of users with scrypt hashes, e.g. [{"email":"a@b.com","role":"admin","hash":"scrypt:<salt>:<hash>"}]
AUTH_USERS=
# long random string that signs the login cookie (changing it logs everyone out)
AUTH_SECRET=

# Optional tuning
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium
# Set to "off" to disable server-side refusal fallback
CLAUDE_FALLBACKS=default
